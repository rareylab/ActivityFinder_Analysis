# Build stacked bar plot for a single coverage mode from scratch.
# This recipe creates/refreshes MVs, extracts interval data, and generates the plot.
#
# Database connection is read from the config file (default: appconfig.toml).
# To use a different database (e.g., TEST), create a separate config file
# (e.g., appconfig_test.toml) and pass it via the app_config parameter.
#
# Parameters:
#   coverage_mode: Coverage mode - one of: full, no-hit, identity-only (default: identity-only)
#   out_dir:       Output directory for CSV and plots (default: ./artifacts)
#   app_config:    Path to app config TOML file (default: uses ACTFIND_CONFIG_FILE or appconfig.toml)
#
# Example usage:
#   just sequence-mapping-single-mode                                         # Uses default config, identity-only
#   just sequence-mapping-single-mode full ./output                           # Full coverage mode
#   just sequence-mapping-single-mode identity-only ./artifacts appconfig_test.toml  # Use test config

sequence-mapping-single-mode coverage_mode="identity-only" out_dir="./artifacts" app_config=config_file:
    #!/usr/bin/env bash
    set -euo pipefail

    dest="{{ out_dir }}"
    dest="${dest/#\~/$HOME}"
    mkdir -p "${dest}"

    echo "🎯 SEQUENCE MAPPING SINGLE-MODE PIPELINE"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📋 Config file:   {{ app_config }}"
    echo "📊 Coverage mode: {{ coverage_mode }}"
    echo "📂 Output dir:    ${dest}"
    echo ""

    # Source DB credentials if available (for password via environment variable)
    if [ -n "{{ db_credentials_file }}" ] && [ -f "{{ db_credentials_file }}" ]; then
        echo "📥 Sourcing DB credentials from {{ db_credentials_file }}"
        # shellcheck disable=SC1090
        . "{{ db_credentials_file }}"
    fi

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # PHASE 1: Create/Refresh Materialized Views
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ PHASE 1: Create/Refresh Materialized Views ━━━"

    # Drop and recreate MVs to ensure latest SQL definitions are applied
    for mv in mv_alignment_sequence_metrics mv_alignment_sequence_metrics_chain; do
        echo "▶ Dropping $mv (if exists)..."
        uv run actfind --app-config {{ app_config }} sql-manager drop "$mv" --force || true
        echo "▶ Creating $mv..."
        uv run actfind --app-config {{ app_config }} sql-manager create "$mv"
    done
    echo "✅ Phase 1 complete: MVs created"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # PHASE 2: Generate Interval CSV Data
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ PHASE 2: Generate Interval CSV ({{ coverage_mode }}) ━━━"

    uv run actfind --app-config {{ app_config }} sequence-mapper generate-all \
        --output-dir "${dest}" \
        --coverage-modes "{{ coverage_mode }}"

    echo "✅ Phase 2 complete: Interval CSV generated"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # PHASE 3: Create Stacked Bar Plots
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ PHASE 3: Create Stacked Bar Plots ━━━"

    # Convert coverage_mode from hyphenated (identity-only) to underscored (identity_only) for filenames
    mode_underscore=$(echo "{{ coverage_mode }}" | tr '-' '_')
    csv_file="${dest}/target_matches_by_sequences_sequence_identity_ranges_${mode_underscore}.csv"
    png_file="${dest}/target_matching_interval_stacked_bars_${mode_underscore}.png"
    pdf_file="${dest}/target_matching_interval_stacked_bars_${mode_underscore}.pdf"

    if [ -f "${csv_file}" ]; then
        echo "▶ Creating PNG plot..."
        uv run actfind --no-tunnel sequence-mapper plot \
            --input "${csv_file}" \
            --output "${png_file}" \
            --coverage-mode "{{ coverage_mode }}"

        echo "▶ Creating PDF plot..."
        uv run actfind --no-tunnel sequence-mapper plot \
            --input "${csv_file}" \
            --output "${pdf_file}" \
            --coverage-mode "{{ coverage_mode }}"

        echo "✅ Phase 3 complete: Plots created"
    else
        echo "❌ Error: CSV file not found: ${csv_file}"
        exit 1
    fi

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🎉 PIPELINE COMPLETE!"
    echo "   📊 CSV:  ${csv_file}"
    echo "   🖼  PNG:  ${png_file}"
    echo "   📄 PDF:  ${pdf_file}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ========================================
# Amino Acid Mapping
# ========================================
# Create amino acid mapping plots (PNG/PDF + CSV summary)
#
# The input CSV must contain amino acid mappings from the PDB Chemical Component
# Dictionary (CCD). This data is NOT generated from the database - it must be
# obtained externally.
#
# Expected CSV format (semicolon-delimited):
#   "Three Letter Code";"One Letter  Code";"Name"
#   "ALA";"A";"ALANINE"
#   "MSE";"M";"SELENOMETHIONINE"
#
# Where to obtain the input CSV:
#   1. PDB Chemical Component Dictionary: https://www.wwpdb.org/data/ccd
#   2. Filter CCD for amino acid-type components (_chem_comp.type contains "PEPTIDE")
#   3. Extract columns: mon_id (Three Letter Code), one_letter_code, name
#
# Example usage:
#   just aa-plot ./input/amino_acid_mapping.csv ./artifacts amino_acid_distribution_colored

aa-plot csv_file output_dir="./artifacts" filename="amino_acid_distribution_colored" delimiter=";":
    #!/usr/bin/env bash
    set -euo pipefail

    echo "🧬 AMINO ACID MAPPING PLOT"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📄 CSV file:    {{ csv_file }}"
    echo "📂 Output dir:  {{ output_dir }}"
    echo "📄 Filename:    {{ filename }}"
    echo ""

    # Check if input CSV file exists
    if [ ! -f "{{ csv_file }}" ]; then
        echo "❌ ERROR: Input CSV file not found: {{ csv_file }}"
        echo ""
        echo "The amino acid mapping CSV must be obtained from an external source."
        echo "This data comes from the PDB Chemical Component Dictionary (CCD),"
        echo "NOT from the ActivityFinder database."
        echo ""
        echo "To obtain the input CSV:"
        echo "  1. Download CCD from: https://www.wwpdb.org/data/ccd"
        echo "  2. Filter for amino acid components (_chem_comp.type contains 'PEPTIDE')"
        echo "  3. Extract columns: mon_id, one_letter_code, name"
        echo "  4. Save as semicolon-delimited CSV with headers:"
        echo '     "Three Letter Code";"One Letter  Code";"Name"'
        echo ""
        echo "Example row:"
        echo '     "ALA";"A";"ALANINE"'
        exit 1
    fi

    # Validate CSV has expected headers
    if ! head -1 "{{ csv_file }}" | grep -qi "three.*letter\|one.*letter"; then
        echo "⚠️  WARNING: CSV may not have expected headers."
        echo "   Expected: 'Three Letter Code', 'One Letter  Code', 'Name'"
        echo "   Found:    $(head -1 '{{ csv_file }}')"
        echo ""
    fi

    mkdir -p "{{ output_dir }}"

    echo "▶ Creating amino acid mapping plots..."
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        plot-amino-acid-mapping \
        --input "{{ csv_file }}" \
        --output-dir "{{ output_dir }}" \
        --output-prefix "{{ filename }}" \
        --delimiter "{{ delimiter }}" \
        --pdf \
        --no-show

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🎉 AMINO ACID MAPPING PLOTS CREATED!"
    echo "   📊 PNG: {{ output_dir }}/{{ filename }}.png"
    echo "   📄 PDF: {{ output_dir }}/{{ filename }}.pdf"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ========================================
# Utility Recipes
