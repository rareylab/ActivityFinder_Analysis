# Quick start recipe for new users
quickstart:
    #!/usr/bin/env bash
    echo "🚀 Quick start setup..."

    # Check for sample configs
    het_sample="activity_db_analysis/apps/het_code_plot/appconfig_sample.toml"
    variant_sample="activity_db_analysis/apps/variant_mutation_plot/appconfig_sample.toml"

    if [ -f "$het_sample" ] || [ -f "$variant_sample" ]; then
        if [ ! -f "appconfig.toml" ]; then
            echo "📋 Copying sample configuration to project root..."
            if [ -f "$het_sample" ]; then
                cp "$het_sample" appconfig.toml
            elif [ -f "$variant_sample" ]; then
                cp "$variant_sample" appconfig.toml
            fi
            echo "⚠️  Please edit appconfig.toml with your database credentials before running plots"
        else
            echo "✅ Configuration file already exists: appconfig.toml"
        fi
    else
        echo "⚠️  Sample config not found, please create appconfig.toml manually"
    fi

    echo "🔍 Running dependency check..."
    just check

    echo ""
    echo "🎯 Next steps:"
    echo "  1. Edit appconfig.toml with your database credentials"
    echo "  2. Update output directory in justfile if needed (current: {{ output_dir }})"
    echo "  3. Run 'just plot-all' to create all plots"
    echo "  4. Or run 'just plot-het' or 'just plot-variant' for specific plot types"

# Show current configuration
config:
    @echo "🔧 Current Configuration:"
    @echo "  Output directory: {{ output_dir }}"
    @echo "  SQL queries: Embedded in Python modules"
    @echo "  Project root: $(pwd)"
    @echo ""
    @echo "📁 Key files:"
    @echo "  appconfig.toml: $(if [ -f appconfig.toml ]; then echo '✅ exists'; else echo '❌ missing'; fi)"
    @echo "  het_code_sql.py: $(if [ -f activity_db_analysis/apps/het_code_plot/het_code_sql.py ]; then echo '✅ exists'; else echo '❌ missing'; fi)"
    @echo "  variant_mutation_sql.py: $(if [ -f activity_db_analysis/apps/variant_mutation_plot/variant_mutation_sql.py ]; then echo '✅ exists'; else echo '❌ missing'; fi)"

# ========================================
# Master Build Recipe - Build All 6 Publication Artifacts
# ========================================
# Generates all 6 publication artifacts defined in desired_artifacts.txt:
#   1. amino_acid_distribution_colored (requires external CSV)
#   2. mutation_distribution_plot
#   3. variants_per_het_code_histogram
#   4. target_matching_interval_stacked_bars_identity_only
#   5. ligand_match_levels.tex
#   6. pair_identity_distribution_activity_combined_panel
#
# Parameters:
#   out_dir: Output directory for all artifacts (default: ./artifacts)
#   aa_csv: Path to amino acid mapping CSV from PDB CCD (optional - skips if not provided)
#
# Example usage:
#   just build-all-artifacts ./artifacts
#   just build-all-artifacts ./artifacts ../../activityFinderAnalysis/examples/amino_acid_mapping.csv

build-all-artifacts out_dir="./artifacts" aa_csv="":
    #!/usr/bin/env bash
    set -euo pipefail

    dest="{{ out_dir }}"
    dest="${dest/#\~/$HOME}"
    mkdir -p "${dest}"

    # Source DB credentials if available
    if [ -n "{{ db_credentials_file }}" ] && [ -f "{{ db_credentials_file }}" ]; then
        echo "📥 Sourcing DB credentials from {{ db_credentials_file }}"
        . "{{ db_credentials_file }}"
    fi

    echo "🏗️  BUILD ALL 6 PUBLICATION ARTIFACTS"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "📂 Output directory: ${dest}"
    echo ""
    echo "Artifacts to build:"
    echo "  1. amino_acid_distribution_colored"
    echo "  2. mutation_distribution_plot"
    echo "  3. variants_per_het_code_histogram"
    echo "  4. target_matching_interval_stacked_bars_identity_only"
    echo "  5. ligand_match_levels.tex"
    echo "  6. pair_identity_distribution_activity_combined_panel"
    echo ""

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # ARTIFACT 1: amino_acid_distribution_colored
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ [1/6] amino_acid_distribution_colored ━━━"
    if [ -n "{{ aa_csv }}" ] && [ -f "{{ aa_csv }}" ]; then
        echo "▶ Creating amino acid distribution plot from {{ aa_csv }}..."
        just aa-plot "{{ aa_csv }}" "${dest}" amino_acid_distribution_colored
        echo "✅ amino_acid_distribution_colored created"
    else
        echo "⚠️  SKIPPED: No amino acid CSV provided or file not found."
        echo "   To include this artifact, provide the aa_csv parameter:"
        echo "   just build-all-artifacts ${dest} /path/to/amino_acid_mapping.csv"
    fi

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # ARTIFACT 2: mutation_distribution_plot
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ [2/6] mutation_distribution_plot ━━━"
    echo "▶ Creating variant mutation plot..."
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        plot-variant-mutations \
        --output-dir "${dest}"
    # Copy from subdirectory to main output
    if [ -f "${dest}/figures/mutation_distribution_plot.png" ]; then
        cp "${dest}/figures/mutation_distribution_plot.png" "${dest}/" 2>/dev/null || true
        cp "${dest}/figures/mutation_distribution_plot.pdf" "${dest}/" 2>/dev/null || true
    fi
    echo "✅ mutation_distribution_plot created"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # ARTIFACT 3: variants_per_het_code_histogram
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ [3/6] variants_per_het_code_histogram ━━━"
    echo "▶ Creating HET code variants histogram..."
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        plot-het-code-variants \
        --output-dir "${dest}"
    # Copy from subdirectory to main output
    if [ -f "${dest}/figures/variants_per_het_code_histogram.png" ]; then
        cp "${dest}/figures/variants_per_het_code_histogram.png" "${dest}/" 2>/dev/null || true
        cp "${dest}/figures/variants_per_het_code_histogram.pdf" "${dest}/" 2>/dev/null || true
    fi
    echo "✅ variants_per_het_code_histogram created"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # ARTIFACT 4: target_matching_interval_stacked_bars_identity_only
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ [4/6] target_matching_interval_stacked_bars_identity_only ━━━"
    echo "▶ Creating sequence mapping stacked bars (identity-only mode)..."
    just sequence-mapping-single-mode identity-only "${dest}"
    echo "✅ target_matching_interval_stacked_bars_identity_only created"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # ARTIFACT 5: ligand_match_levels.tex
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ [5/6] ligand_match_levels.tex ━━━"
    echo "▶ Creating ligand match levels table..."
    just ligand-match-level-counts "${dest}"
    echo "✅ ligand_match_levels.tex created"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    # ARTIFACT 6: pair_identity_distribution_activity_combined_panel
    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━ [6/6] pair_identity_distribution_activity_combined_panel ━━━"
    echo "▶ Pulling pair identity distribution data..."
    just pair-identity-distribution-activity-data-pull "${dest}"
    echo "▶ Creating pair identity distribution plots..."
    just pair-identity-distribution-activity-plots "${dest}" "${dest}"
    echo "✅ pair_identity_distribution_activity_combined_panel created"

    # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "🎉 BUILD COMPLETE!"
    echo ""
    echo "Generated artifacts in ${dest}:"
    ls -la "${dest}"/*.png "${dest}"/*.tex "${dest}"/*.pdf 2>/dev/null || true
    echo ""
    if [ -z "{{ aa_csv }}" ]; then
        echo "⚠️  Note: amino_acid_distribution_colored was skipped (no CSV provided)"
    fi
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
