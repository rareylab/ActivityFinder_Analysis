# Justfile for ActivityFinder Analysis
# Run `just --list` to see available recipes
# =============================================================================
# CONFIGURATION - Update these paths to match your local environment
# =============================================================================
# Default output directories - change these to your preferred locations
# Base output directory - commands create subdirectories as needed (figures/, tables/)

output_dir := "./output"
ligand_reports_dir := "./output/tables"
figures_dir := "./output/figures"
ligand_mapping_tables_dir := "./output/tables"

# Environment variable overrides for open-source deployment:
# - ACTFIND_DB_CREDENTIALS_FILE: Path to shell script that exports DB credentials
# - ACTFIND_CONFIG_FILE: Path to the app configuration TOML file (default: appconfig.toml)

db_credentials_file := env_var_or_default("ACTFIND_DB_CREDENTIALS_FILE", "")
config_file := env_var_or_default("ACTFIND_CONFIG_FILE", "appconfig.toml")

# Default recipe - show help
default:
    @just --list

# ========================================
# Ligand Match Level Counts
# ========================================

ligand-match-level-counts output_dir="./output/tables":
    #!/usr/bin/env bash
    echo "🧪 Creating ligand match level count table..."
    echo "📂 Output directory: {{ output_dir }}"
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        ligand-match-level-counts \
        --output-dir {{ output_dir }}
    echo "✅ Ligand match level count table created successfully!"

# -------------------------------------------------------------
# Activity-qualified Pair Identity Distribution (data pull)
# (Generates disjoint + cumulative CSV + LaTeX)

# -------------------------------------------------------------
pair-identity-distribution-activity-data-pull output_dir=ligand_mapping_tables_dir:
    #!/usr/bin/env bash
    echo "🧪 Pulling activity-qualified pair identity distribution data (disjoint + cumulative)..."
    echo "📂 Tables directory: {{ output_dir }}"
    mkdir -p "{{ output_dir }}"
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        pair-identity-distribution-activity \
        --output-dir "{{ output_dir }}"
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        pair-identity-distribution-activity \
        --cumulative \
        --output-dir "{{ output_dir }}"
    echo "✅ Pair identity distribution data (CSV + LaTeX) written."

# -------------------------------------------------------------
# Activity-qualified Pair Identity Distribution (plotting)
# Produces: disjoint counts+normalized, cumulative counts+normalized, combined 2x2 panel

# -------------------------------------------------------------
pair-identity-distribution-activity-plots output_dir=figures_dir tables_dir=ligand_mapping_tables_dir:
    #!/usr/bin/env bash
    echo "🖼️ Creating pair identity distribution plots (counts + normalized + combined)..."
    echo "📄 Disjoint CSV: {{ tables_dir }}/pair_identity_distribution_activity.csv"
    echo "📄 Cumulative CSV: {{ tables_dir }}/pair_identity_distribution_activity_cumulative.csv"
    echo "🖼  Figures directory: {{ output_dir }}"
    mkdir -p "{{ output_dir }}"
    # Disjoint (counts + normalized)
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        plot-pair-identity-distribution-activity \
        --input "{{ tables_dir }}/pair_identity_distribution_activity.csv" \
        --output-dir "{{ output_dir }}" \
        --pdf
    # Cumulative (counts + normalized)
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        plot-pair-identity-distribution-activity \
        --input "{{ tables_dir }}/pair_identity_distribution_activity_cumulative.csv" \
        --output-dir "{{ output_dir }}" \
        --output-prefix "pair_identity_distribution_activity_cumulative" \
        --pdf
    # Combined disjoint vs cumulative (2x2)
    uv run actfind --app-config {{ config_file }} --logging-level INFO \
        plot-pair-identity-distribution-activity \
        --input "{{ tables_dir }}/pair_identity_distribution_activity.csv" \
        --cumulative-input "{{ tables_dir }}/pair_identity_distribution_activity_cumulative.csv" \
        --output-dir "{{ output_dir }}" \
        --output-prefix "pair_identity_distribution_activity" \
        --combined \
        --pdf
    echo "✅ Pair identity distribution plots created."

