# Clean up generated files in default output directory
clean:
    #!/usr/bin/env bash
    echo "🧹 Cleaning up generated files in {{ output_dir }}..."
    if [ -d "{{ output_dir }}" ]; then
        rm -f {{ output_dir }}/*het_code* {{ output_dir }}/*variants* {{ output_dir }}/*mutation* {{ output_dir }}/target_matches_by_*
        echo "✅ Cleanup completed!"
    else
        echo "📁 Output directory doesn't exist, nothing to clean"
    fi

# Clean up files in a specific directory
clean-dir target_dir:
    #!/usr/bin/env bash
    echo "🧹 Cleaning up generated files in {{ target_dir }}..."
    if [ -d "{{ target_dir }}" ]; then
        rm -f {{ target_dir }}/*het_code* {{ target_dir }}/*variants* {{ target_dir }}/*mutation* {{ target_dir }}/target_matches_by_*
        echo "✅ Cleanup completed!"
    else
        echo "📁 Target directory doesn't exist, nothing to clean"
    fi

# Check if required dependencies are available
check:
    #!/usr/bin/env bash
    echo "🔍 Checking dependencies..."

    # Check if uv is available
    if command -v uv >/dev/null 2>&1; then
        echo "✅ uv command is available"
    else
        echo "❌ uv command not found. Please install uv first."
        exit 1
    fi

    # Check if appconfig.toml exists
    if [ -f "appconfig.toml" ]; then
        echo "✅ Configuration file found: appconfig.toml"
    else
        echo "❌ appconfig.toml not found in project root"
        echo "   Please create it with database credentials"
        exit 1
    fi

    # Test actfind command
    if uv run actfind --help >/dev/null 2>&1; then
        echo "✅ actfind command is working"
    else
        echo "❌ actfind command not working. Check your uv environment."
        exit 1
    fi

    echo "🎉 All checks passed!"

